# Copy to backend/.env and adjust. Never commit the real .env file.

# --- Required in production -------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me

# True only for local development.
DJANGO_DEBUG=True

# Comma-separated host names this backend answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# React origins allowed to call the API (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Needed in production for admin forms served over HTTPS, e.g. https://admin.example.com
CSRF_TRUSTED_ORIGINS=

# Public website URL (used for the admin "View site" link).
FRONTEND_URL=http://localhost:5173

# --- Google Sign-In ----------------------------------------------------------------
# OAuth client ID (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application). Add your site origins (e.g.
# http://localhost:5173) under "Authorised JavaScript origins".
# Use the same value for VITE_GOOGLE_CLIENT_ID in the frontend .env.
GOOGLE_CLIENT_ID=
# Not needed for the Google button flow; keep it secret if you store it here.
GOOGLE_CLIENT_SECRET=

# --- Optional -----------------------------------------------------------------
# Move the admin away from /admin/ in production, e.g. rk-manage/
DJANGO_ADMIN_URL=admin/

# Upload limit for category/product images (MB).
MAX_IMAGE_UPLOAD_MB=5

# DJANGO_SQLITE_PATH=/absolute/path/db.sqlite3
# DJANGO_MEDIA_ROOT=/absolute/path/media
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=0
# API_ANON_RATE=600/minute
# API_USER_RATE=1200/minute
# API_AUTH_RATE=10/minute
